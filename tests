from models.animal import Animal

def test_animal():
	animal = Animal(
			animal_id = 1,
			name = "Mimosa"
)
	
	assert animal.animal_id == 1
	assert animal.name == "Mimosa"

def vacinar():
	animal.vacinar("Raiva", "23/04/2026")

	assert vacinar.name == "Raiva"
	assert vacinar.data == "23/04/2026"

def alimentar():
	animal.alimentar("Super", 30, "25/05/2026")

	assert alimentar.name == "Super"
	assert alimentar.quantidade == 30
	assert alimentar.date == "23/03/2026"

